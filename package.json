{
  "name": "agent-floor",
  "version": "0.1.1",
  "description": "A live 3D office for your coding agents. See every agent at its desk, what it is doing, and who it is talking to. Works with Claude Code, Codex, Cursor, or anything that can send an HTTP request.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "agent-floor": "bin/agent-floor.mjs"
  },
  "files": [
    "adapters",
    "bin",
    "desktop",
    "dist",
    "server",
    "shared"
  ],
  "keywords": [
    "agents",
    "claude-code",
    "codex",
    "cursor",
    "visualization",
    "threejs",
    "multi-agent",
    "observability"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base=./ --mode pages --outDir dist-pages",
    "start": "node bin/agent-floor.mjs start --open",
    "demo": "node bin/agent-floor.mjs demo",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/develop212/agent-floor.git"
  },
  "homepage": "https://github.com/develop212/agent-floor#readme",
  "bugs": {
    "url": "https://github.com/develop212/agent-floor/issues"
  },
  "optionalDependencies": {
    "electron": "^44.7.0"
  }
}
